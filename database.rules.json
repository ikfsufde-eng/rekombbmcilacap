{
  "rules": {
    "layanan": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['aktif'])",
      "aktif": {
        ".validate": "newData.isBoolean()"
      },
      "oleh": {
        ".validate": "newData.isString() && newData.val().length <= 40"
      },
      "ts": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },
    "sesi": {
      ".read": true,
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['nama','alamat','keperluan','status','ts'])",
        "nama": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "alamat": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "keperluan": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "status": {
          ".validate": "newData.val() == 'MENUNGGU' || newData.val() == 'DITERIMA' || newData.val() == 'DIESKALASI' || newData.val() == 'DITANGANI' || newData.val() == 'SELESAI'"
        },
        "resepsionis": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "petugas": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "ts_update": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "faq": {
      ".read": true,
      ".indexOn": [
        "ts"
      ],
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['tanya','jawab','ts'])",
        "tanya": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "jawab": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000"
        },
        "kategori": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}